# Local web-app settings. Render supplies DATABASE_URL and PORT.
APP_TITLE=Smart Attendance
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/smart_attendance
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# The legacy desktop application uses its own local sign-in. Configure these
# only if continuing to run run_attendance.py:
ATTENDANCE_ADMIN_USERNAME=
ATTENDANCE_ADMIN_PASSWORD=
